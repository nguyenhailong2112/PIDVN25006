[Unit]
Description=PIDVN25006 AGV Vision Runtime Supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/PIDVN25006
Environment=PIDVN_CONDA_ENV=pidvn25006
Environment=PIDVN_CONDA_SH=/home/ubuntu/miniconda3/etc/profile.d/conda.sh
ExecStartPre=/usr/bin/mkdir -p /opt/PIDVN25006/outputs/runtime/supervisor
ExecStart=/opt/PIDVN25006/run_forever_conda.sh
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
StandardOutput=append:/opt/PIDVN25006/outputs/runtime/supervisor/systemd_stdout.log
StandardError=append:/opt/PIDVN25006/outputs/runtime/supervisor/systemd_stderr.log

[Install]
WantedBy=multi-user.target
