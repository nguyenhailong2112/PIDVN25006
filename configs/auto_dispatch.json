{
  "enabled": true,
  "dry_run": false,
  "operation_mode": "manual",
  "require_bind_notify": true,
  "require_canonical": true,
  "query_interval_sec": 5.0,
  "query_task_include_agv_code": false,
  "reserve_dispatched_destination_slots": false,
  "completed_statuses": ["9", "completed", "complete", "finish", "finished", "ended", "success"],
  "failed_statuses": ["5", "failed", "fail", "cancel", "canceled", "cancelled", "abort", "aborted"],
  "running_statuses": ["1", "2", "3", "6", "created", "executing", "sending", "resending", "running"],
  "abnormal_statuses": ["0", "4", "10", "sending_exception", "canceling", "cancelling", "interrupted"],
  "abnormal_status_release_sec": 300,
  "task_overdue_warn_sec": 3600,
  "failed_task_cooldown_sec": 60,
  "max_consecutive_failed_tasks": 3,
  "api_server": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 8023,
    "base_path": "/service/rest/visionAutoDispatch",
    "allowlist": ["192.168.10.105"],
    "log_max_mb": 10.0,
    "log_backup_count": 5
  },
  "task_template": {
    "api": "genAgvSchedulingTask",
    "interfaceName": "genAgvSchedulingTask",
    "path_field": "userCallCodePath",
    "path_sequence": ["{source}", "{dest}"],
    "send_task_code": true,
    "include_data": true
  }
}
